<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_950">

    <!-- Top Bar: Model Switcher & Shield -->
    <LinearLayout
        android:id="@+id/layout_chat_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slate_900"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Clickable Model Switcher Pill -->
        <LinearLayout
            android:id="@+id/btn_model_switcher"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_model_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Sparkles"
                android:src="@drawable/ic_sparkles" />

            <TextView
                android:id="@+id/tv_active_model_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Gemini 1.5 Flash"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="▼"
                android:textColor="@color/slate_400"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Failover Shield Status -->
        <LinearLayout
            android:id="@+id/layout_failover_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Failover Active"
                android:src="@drawable/ic_shield" />

            <TextView
                android:id="@+id/tv_shield_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Auto-Failover"
                android:textColor="@color/emerald_light"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_clear_chat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear Chat"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Messages Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/layout_thinking"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_chat_topbar"
        tools:listitem="@layout/item_chat_assistant" />

    <!-- Thinking Progress indicator -->
    <LinearLayout
        android:id="@+id/layout_thinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slate_900"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layout_suggestions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/thinking_ai"
            android:textColor="@color/slate_300"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Suggested Prompts (NotebookLM Style Quick Questions) -->
    <HorizontalScrollView
        android:id="@+id/layout_suggestions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/slate_950"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layout_input_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/container_suggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_prompt_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_model_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Apa kesimpulan Bab 3?"
                android:textColor="@color/slate_300"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_prompt_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_model_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Jelaskan teorema CAP pada sistem terdistribusi"
                android:textColor="@color/slate_300"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_prompt_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_model_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Bandingkan latensi Gemini dan Groq"
                android:textColor="@color/slate_300"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/layout_input_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/slate_900"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/chat_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/white"
            android:textColorHint="@color/slate_400"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_user"
            android:contentDescription="@string/btn_send"
            android:src="@drawable/ic_send" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
