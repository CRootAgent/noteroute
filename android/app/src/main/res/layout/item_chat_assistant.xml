<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_chat_assistant"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Model Badge + Latency -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_model_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_model_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/primary_light"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="gemini-1.5-flash" />

            <TextView
                android:id="@+id/tv_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/slate_400"
                android:textSize="11sp"
                tools:text="482 ms" />

            <TextView
                android:id="@+id/tv_fallback_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="[Failover Aktif]"
                android:textColor="@color/emerald_light"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Response Body -->
        <TextView
            android:id="@+id/tv_assistant_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/slate_100"
            android:textSize="14sp"
            tools:text="Berdasarkan Slide Bab 3, kesimpulan utamanya adalah bahwa dalam sistem terdistribusi, teorema CAP menyatakan bahwa kita hanya dapat menjamin dua dari tiga sifat: Consistency, Availability, dan Partition Tolerance." />

        <!-- Citations Label & Badges Container -->
        <LinearLayout
            android:id="@+id/layout_citations_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/citations_label"
                android:textColor="@color/slate_400"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Horizontal Container for Citation Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/container_citation_badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_assistant_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/slate_500"
        android:textSize="10sp"
        tools:text="10:43" />

</LinearLayout>
